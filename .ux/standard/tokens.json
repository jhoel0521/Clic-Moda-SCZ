{
  "$description": "Design tokens (DTCG 2025.10) extraidos por ux-init de apps/shop/tailwind.config.ts y src/app/globals.css. Capas: primitive -> semantic. Solo modo claro: el codigo no define modo oscuro. Pendiente de confirmar por ux-discover.",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": {
          "$value": "#ffffff"
        },
        "50": {
          "$value": "#fff9fb",
          "$description": "bg del sitio"
        },
        "100": {
          "$value": "#f8f2f4",
          "$description": "bg secundario"
        },
        "150": {
          "$value": "#f6eef1",
          "$description": "hover de superficie"
        },
        "400": {
          "$value": "#8a7a84",
          "$description": "text muted en codigo"
        },
        "600": {
          "$value": "#5d4c56",
          "$description": "text secondary en codigo"
        },
        "900": {
          "$value": "#24151c",
          "$description": "text primary en codigo"
        }
      },
      "brand": {
        "300": {
          "$value": "#ff6b96",
          "$description": "brand light"
        },
        "500": {
          "$value": "#e63f6e",
          "$description": "brand DEFAULT"
        },
        "700": {
          "$value": "#c7305a",
          "$description": "brand dark"
        },
        "violet": {
          "$value": "#c026d3",
          "$description": "solo en gradientes de marca"
        }
      },
      "red": {
        "600": {
          "$value": "#dc2626"
        },
        "700": {
          "$value": "#b91c1c"
        }
      },
      "green": {
        "600": {
          "$value": "#16a34a"
        },
        "700": {
          "$value": "#15803d"
        }
      },
      "amber": {
        "600": {
          "$value": "#d97706"
        }
      },
      "sky": {
        "600": {
          "$value": "#0284c7"
        }
      },
      "border-subtle": {
        "$value": "#ede7e9",
        "$description": "Aproximacion: rgba(30,22,28,0.08) compuesto sobre #fff9fb (el codigo usa transparencia)"
      }
    },
    "space": {
      "0": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "1": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
