    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 250,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 400,
          "unit": "ms"
        }
      }
    },
    "font-family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "$type": "color",
        "bg": {
          "$value": "{primitive.color.neutral.50}"
        },
        "surface": {
          "$value": "{primitive.color.neutral.0}"
        },
        "text": {
          "$value": "{primitive.color.neutral.900}"
        },
        "text-secondary": {
          "$value": "{primitive.color.neutral.600}"
        },
        "text-muted": {
          "$value": "{primitive.color.neutral.400}"
        },
        "border": {
          "$value": "{primitive.color.border-subtle}",
          "$description": "Borde del codigo (decorativo). Para inputs se exige >=3:1"
        },
        "action": {
          "$value": "{primitive.color.brand.500}"
        },
        "on-action": {
          "$value": "{primitive.color.neutral.0}"
        },
        "danger": {
          "$value": "{primitive.color.red.600}"
        },
        "success": {
          "$value": "{primitive.color.green.600}"
        },
        "warning": {
          "$value": "{primitive.color.amber.600}"
        },
        "info": {
          "$value": "{primitive.color.sky.600}"
        },
        "focus": {
          "$value": "{primitive.color.brand.500}"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "target-min": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "WCAG 2.5.8 AA"
      },
      "target-touch": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "Material 48dp / iOS 44pt"
      }
    }
  },
  "$extensions": {
    "ux-kit.contrast-pairs": [
      {
        "fg": "semantic.light.color.text",
        "bg": "semantic.light.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.text-secondary",
        "bg": "semantic.light.color.surface",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.text-muted",
        "bg": "semantic.light.color.surface",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.on-action",
        "bg": "semantic.light.color.action",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.border",
        "bg": "semantic.light.color.bg",
        "min": 3
      },
      {
        "fg": "semantic.light.color.danger",
        "bg": "semantic.light.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.success",
        "bg": "semantic.light.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.warning",
        "bg": "semantic.light.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.action",
        "bg": "semantic.light.color.bg",
        "min": 3
      }
    ],
    "ux-kit.status": "extracted",
    "ux-kit.notes": "space y font-size mantienen los valores de la plantilla: el codigo usa la escala por defecto de Tailwind y no los define; sin confirmar."
  }
}
