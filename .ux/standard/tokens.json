        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "4": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "6": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "8": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "12": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "16": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      },
      "$type": "dimension"
    },
    "font-size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
