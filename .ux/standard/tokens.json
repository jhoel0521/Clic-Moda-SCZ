      },
      "xl": {
        "$value": {
          "value": 25,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 31,
          "unit": "px"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 6,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 16,
          "unit": "px"
