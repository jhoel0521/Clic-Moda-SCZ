# Copia este archivo a .env y completa los valores. .env NO se sube a git.
# Estas mismas variables las leen la API y docker compose (una sola fuente).

# --- API ---
NODE_ENV=development
PORT=10010

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=10001
DB_USER=clic_moda
DB_PASSWORD=
DB_NAME=clic_moda

# --- Imagenes (SeaweedFS, compatible con S3) ---
# Aislado: solo la API lo consulta. Las claves las usan la API y docker compose; genera dos distintas:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# MEDIA_STORAGE: s3 (SeaweedFS) | disk (respaldo local, carpeta MEDIA_DISK_DIR)
MEDIA_STORAGE=s3
S3_ENDPOINT=http://127.0.0.1:10002
S3_BUCKET=clic-moda-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_DISK_DIR=.media

# --- Autenticacion ---
# Clave para firmar los tokens de acceso (>= 32 caracteres, aleatoria). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_KEY=
AUTH_JWT_ISSUER=clic-moda-api
AUTH_JWT_AUDIENCE=clic-moda
# Costo de scrypt (2^N). 17 recomendado; no lo bajes en produccion.
AUTH_SCRYPT_LOG_N=17

# --- Primer Gerente (comando seed:manager) ---
# El comando falla nombrando las que falten. La contrasena: minimo 12 caracteres.
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_PASSWORD=
INITIAL_MANAGER_NAME=Gerente

# --- Cola de stock ---
# Procesador de comandos de stock: on | off (off para correrlo en otro proceso).
STOCK_QUEUE_WORKER=on
STOCK_QUEUE_POLL_MS=200
# Despachador de eventos (on|off) y su espera sin trabajo en ms
EVENT_DISPATCHER=on
EVENT_DISPATCH_POLL_MS=500
