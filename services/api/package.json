{
  "name": "clic-moda-api",
  "version": "0.0.0",
  "private": true,
  "description": "API compartida y tiempo real (NestJS + PostgreSQL)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "db:cli": "node --env-file-if-exists=.env node_modules/typeorm/cli.js",
    "migration:run": "pnpm build && pnpm db:cli migration:run -d dist/shared/infrastructure/database/data-source.js",
    "migration:revert": "pnpm build && pnpm db:cli migration:revert -d dist/shared/infrastructure/database/data-source.js",
    "migration:show": "pnpm build && pnpm db:cli migration:show -d dist/shared/infrastructure/database/data-source.js",
    "migration:generate": "pnpm build && pnpm db:cli migration:generate --esm -d dist/shared/infrastructure/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/authentication": "0.1.5",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "4.1.12"
  }
}
