---
import '../styles/global.css';
import LogoutButton from '../components/LogoutButton';
import { can } from '../lib/session';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;
const links = [
  { href: '/', label: 'Inicio', show: true },
  { href: '/categorias', label: 'Categorías', show: true },
  { href: '/productos', label: 'Productos', show: true },
  { href: '/almacen', label: 'Almacén', show: true },
].filter((link) => link.show);
const path = Astro.url.pathname;
const writes = can(session, 'catalog:write');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Clic Moda</title>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-3 px-4 py-3">
        <a href="/" class="mr-2 text-lg font-bold text-action">
          Clic Moda
        </a>
        <nav aria-label="Principal" class="flex flex-1 flex-wrap gap-1">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={
                path === link.href || (link.href !== '/' && path.startsWith(link.href))
                  ? 'page'
                  : undefined
              }
              class="flex min-h-11 items-center rounded-lg px-3 font-medium hover:bg-line aria-[current=page]:bg-line aria-[current=page]:font-bold"
            >
              {link.label}
            </a>
          ))}
        </nav>
        {session && (
          <div class="flex items-center gap-3">
            <span class="text-sm text-muted">
              {session.user.name} · {session.user.roles.join(', ').toLowerCase()}
              {!writes && ' (solo consulta)'}
            </span>
            <LogoutButton client:load />
          </div>
        )}
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-6">
      <h1 class="mb-6 text-2xl font-bold">{title}</h1>
      <slot />
    </main>
  </body>
</html>
