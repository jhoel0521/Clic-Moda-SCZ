---
import ProductForm from '../../components/ProductForm';
import ProductPhotos from '../../components/ProductPhotos';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { can } from '../../lib/session';

if (!can(Astro.locals.session, 'catalog:write')) return Astro.redirect('/productos');
const { id } = Astro.params;
---

<AdminLayout title="Editar producto">
  <ProductForm client:load productId={id} />
  <!-- Las fotos van fuera del <form> del producto: su subida trae otro formulario y no se pueden anidar. -->
  <div class="mt-5">
    <ProductPhotos client:load productId={id as string} />
  </div>
</AdminLayout>
