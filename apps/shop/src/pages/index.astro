---
import ProductCard from '../components/ProductCard.astro';
import StoreLayout from '../layouts/StoreLayout.astro';
import { CatalogUnavailableError, catalog, type CardProduct } from '../lib/catalog';
import SocialIcon from '../components/SocialIcon.astro';
import { getSettings } from '../lib/settings';
import { hasWhatsapp, whatsappLink } from '../lib/whatsapp';

const { brandName, tagline, contact } = await getSettings();
const whatsapp = hasWhatsapp(contact.whatsapp)
  ? whatsappLink(contact.whatsapp, `Hola ${brandName}, quiero información`)
  : null;
const STEPS = [
  'Elige tu modelo, talla y color.',
  'Consúltanos por WhatsApp.',
  'Pago manual y entrega a domicilio o recojo.',
] as const;
let newest: CardProduct[] = [];
try {
  newest = (await catalog.list({ sort: 'new' })).items.slice(0, 4);
} catch (error) {
  // La portada se ve igual sin las novedades si el catálogo no responde.
  if (!(error instanceof CatalogUnavailableError)) throw error;
}
---

<StoreLayout path="/">
  <h1 class="text-3xl font-bold wrap-anywhere text-brand-dark">{brandName}</h1>
  {tagline && <p class="mt-2 text-lg text-muted">{tagline}</p>}
  <a
    href="/catalogo"
    class="mt-5 inline-flex min-h-12 items-center rounded-xl bg-brand px-6 font-semibold text-on-brand"
  >
    Ver el catálogo
  </a>
  {newest.length > 0 && (
    <section class="mt-10" aria-labelledby="novedades">
      <h2 id="novedades" class="text-xl font-bold">
        Novedades
      </h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-4">
        {newest.map((product, index) => (
          <ProductCard product={product} priority={index < 2} />
        ))}
      </ul>
      <a
        href="/catalogo"
        class="mt-6 inline-flex min-h-12 items-center font-semibold text-brand-dark underline"
      >
        Ver todo el catálogo
      </a>
    </section>
  )}
  <section
    class="mt-14 rounded-3xl bg-white p-6 shadow-md ring-1 ring-black/5 md:p-8"
    aria-labelledby="como-comprar"
  >
    <h2 id="como-comprar" class="text-xl font-bold">
      Cómo comprar
    </h2>
    <ol class="mt-4 grid gap-4 md:grid-cols-3">
      {STEPS.map((step, index) => (
        <li class="flex items-start gap-3">
          <span
            class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-soft font-bold text-brand-dark"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <span class="pt-1">{step}</span>
        </li>
      ))}
    </ol>
    {whatsapp && (
      <a
        href={whatsapp}
        rel="noreferrer"
        class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-xl bg-brand px-6 font-semibold text-on-brand"
      >
        <SocialIcon network="whatsapp" />
        Escribir por WhatsApp
      </a>
    )}
  </section>
</StoreLayout>
