---
import { variantPath } from '../lib/card-variants';
import type { VariantOption } from '../lib/catalog';
import { formatBs } from '../lib/format';
import { optionBase, optionLink } from '../lib/option-styles';

interface Props {
  slug: string;
  chip: VariantOption;
  selected: boolean;
  /** Las tallas cuestan distinto: la píldora lleva su precio. */
  showPrice: boolean;
}

const { slug, chip, selected, showPrice } = Astro.props;
---

<a
  href={variantPath(slug, chip)}
  title={`Talla ${chip.size}`}
  aria-current={selected ? 'true' : undefined}
  class:list={[optionBase('sm'), optionLink(selected), showPrice && 'flex-col gap-0']}
>
  <span>{chip.size}</span>
  {showPrice && <span class="text-xs font-medium">{formatBs(chip.price)}</span>}
</a>
