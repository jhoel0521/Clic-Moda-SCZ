---
import type { Swatch } from '../lib/card-variants';
import ColorSwatch from './ColorSwatch.astro';

interface Props {
  slug: string;
  swatches: Swatch[];
  /** Cuántos círculos se ven; el resto se resume en "+N". */
  max?: number;
}

const { slug, swatches, max = 5 } = Astro.props;
const shown = swatches.slice(0, max);
const hidden = swatches.length - shown.length;
---

<ul class="flex flex-wrap items-center gap-1" aria-label="Colores">
  {shown.map((swatch) => (
    <li>
      <ColorSwatch slug={slug} {...swatch} />
    </li>
  ))}
  {hidden > 0 && <li class="px-1 text-sm font-medium text-muted">+{hidden}</li>}
</ul>
