---
import { cardView, variantPath } from '../lib/card-variants';
import type { CardProduct } from '../lib/catalog';
import { formatBs } from '../lib/format';
import { productPath } from '../lib/inquiry';
import AvailabilityBadge from './AvailabilityBadge.astro';

interface Props {
  product: CardProduct;
  /** Las primeras tarjetas cargan de inmediato; el resto con carga diferida. */
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const { photo } = product;
const view = cardView(product.variants);
const path = productPath(product.slug);
const href = view && !view.soldOut ? variantPath(product.slug, view.featured) : path;
// Qué combinación se está viendo: "Rojo · Talla 36".
const scope =
  view && !view.soldOut
    ? [view.featured.color, `Talla ${view.featured.size}`].filter(Boolean).join(' · ')
    : '';
---

<li class="group relative flex flex-col rounded-3xl bg-white p-1.5 shadow-[0_20px_30px_-22px_rgba(36,21,28,0.35)] ring-1 ring-black/5 transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_28px_36px_-22px_rgba(36,21,28,0.4)] motion-reduce:transition-none motion-reduce:hover:translate-y-0">
  <div class="relative">
    <a href={href} class="block rounded-2xl rounded-tr-[3rem]" tabindex="-1" aria-hidden="true">
      <div class="aspect-[4/5] overflow-hidden rounded-2xl rounded-tr-[3rem] bg-brand-soft">
        {photo ? (
          <img
            src={photo.card}
            alt=""
            width="800"
            height="1000"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
            class="size-full object-cover transition duration-500 group-hover:scale-[1.04] motion-reduce:transition-none"
          />
        ) : (
          <span class="flex size-full items-center justify-center p-4 text-center font-semibold text-brand-dark">
            {product.name}
          </span>
        )}
      </div>
    </a>
    <span class="absolute left-2 top-2">
      <AvailabilityBadge availability={product.availability} quiet={true} />
    </span>
    {view && (
      <p class="absolute -bottom-4 right-3 rounded-2xl rounded-br-3xl bg-white px-3 py-1.5 text-base font-extrabold leading-none text-brand-dark shadow-[0_6px_18px_rgba(36,21,28,0.18)]">
        {formatBs(view.featured.price)}
      </p>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-0.5 px-3 pb-3 pt-6">
    <p class="text-xs font-bold uppercase tracking-wide text-muted">{product.category.name}</p>
    <h3 class="line-clamp-2 text-base font-bold leading-snug wrap-anywhere">
      <a href={href} class="after:absolute after:inset-0 hover:underline">
        {product.name}
      </a>
    </h3>
    {scope && <p class="text-sm text-muted">{scope}</p>}
    {view?.summary && <p class="text-sm text-muted">{view.summary}</p>}
    {!view && <p class="font-bold text-brand-dark">{formatBs(product.price)}</p>}
  </div>
</li>
