---
import type { Product, VariantOption } from '../lib/catalog';
import { productPath } from '../lib/inquiry';
import { optionPrice } from '../lib/pricing';

interface Props {
  product: Product;
  size: string | null;
  color: string | null;
}

const { product, size, color } = Astro.props;
const unique = (values: (string | null)[]): string[] => [
  ...new Set(values.filter((v): v is string => !!v)),
];
const sizes = unique(product.variants.map((v) => v.size));
const colors = unique(product.variants.map((v) => v.color));
// Una opción está agotada solo si TODAS las variantes que la cumplen lo están.
const allOut = (items: VariantOption[]): boolean => items.every((v) => v.availability === 'out');
const sizeOut = (value: string): boolean =>
  allOut(product.variants.filter((v) => v.size === value && (!color || v.color === color)));
const colorOut = (value: string): boolean =>
  allOut(product.variants.filter((v) => v.color === value && (!size || v.size === size)));
const sizeLow = (value: string): boolean =>
  product.variants.some((v) => v.size === value && v.availability === 'low');
const option =
  'relative flex min-h-12 min-w-12 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-neutral-500 px-3 py-1 text-center font-semibold has-[:checked]:border-brand-dark has-[:checked]:bg-brand-soft has-[:disabled]:cursor-not-allowed has-[:disabled]:border-dashed has-[:disabled]:text-muted has-[:focus-visible]:outline-[3px] has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand-dark';
---

<form method="get" action={productPath(product.slug)} data-variant-form class="flex flex-col gap-5">
  <fieldset id="talla" tabindex="-1" class="flex flex-col gap-2">
    <legend class="mb-1 font-semibold">Talla</legend>
    <div class="flex flex-wrap gap-2">
      {sizes.map((value) => (
        <label class={option}>
          <input
            type="radio"
            name="talla"
            value={value}
            checked={value === size}
            disabled={sizeOut(value)}
            class="sr-only"
          />
          <span>{value}</span>
          {product.priceVaries && (
            <span class="text-xs font-medium text-muted">
              {optionPrice(
                product.variants.filter((v) => v.size === value && (!color || v.color === color))
              )}
            </span>
          )}
          {sizeOut(value) && <span class="text-xs font-medium">Agotada</span>}
          {!sizeOut(value) && sizeLow(value) && (
            <span class="text-xs font-medium text-warning">Últimas</span>
          )}
        </label>
      ))}
    </div>
  </fieldset>
  {colors.length > 1 && (
    <fieldset class="flex flex-col gap-2">
      <legend class="mb-1 font-semibold">Color</legend>
      <div class="flex flex-wrap gap-2">
        {colors.map((value) => (
          <label class={option}>
            <input
              type="radio"
              name="color"
              value={value}
              checked={value === color}
              disabled={colorOut(value)}
              class="sr-only"
            />
            <span>{value}</span>
            {product.priceVaries && (
              <span class="text-xs font-medium text-muted">
                {optionPrice(
                  product.variants.filter((v) => v.color === value && (!size || v.size === size))
                )}
              </span>
            )}
            {colorOut(value) && <span class="text-xs font-medium">Agotado</span>}
          </label>
        ))}
      </div>
    </fieldset>
  )}
  <!-- Sin JavaScript hace falta un botón; con JavaScript la elección se aplica al tocarla. -->
  <button
    type="submit"
    class="no-js-only inline-flex min-h-12 items-center justify-center rounded-xl border-2 border-brand-dark px-5 font-semibold text-brand-dark"
  >
    Elegir
  </button>
</form>
<script>
  import { initPicker } from '../scripts/picker';
  initPicker();
</script>
