---
import { splitBrand } from '../lib/brand';
import type { StoreSettings } from '../lib/settings';

interface Props {
  settings: StoreSettings;
  class?: string;
}

const { settings, class: className = '' } = Astro.props;
const { logo, brandName } = settings;
const { lead, accent } = splitBrand(brandName);
---

<a
  href="/"
  class:list={['min-w-0 rounded-xl', className]}
  aria-label={`${brandName}, ir al inicio`}
>
  {logo ? (
    <img
      src={logo.path}
      alt={brandName}
      width="160"
      height="80"
      class="h-9 w-auto max-w-[40vw] object-contain lg:h-10"
    />
  ) : (
    <span class="block truncate text-xl font-black tracking-tight text-ink sm:text-2xl">
      {lead}
      {accent && <span class="text-brand-dark"> {accent}</span>}
    </span>
  )}
</a>
