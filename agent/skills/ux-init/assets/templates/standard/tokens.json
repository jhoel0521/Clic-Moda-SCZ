{
  "$description": "Design tokens (DTCG 2025.10). PLACEHOLDER VALUES: ux-init extracts real values from the project theme and ux-discover defines the brand. Layers: primitive -> semantic. Technology-agnostic: values only, never framework class names.",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": {
          "$value": "#ffffff"
        },
        "50": {
          "$value": "#f8fafc"
        },
        "100": {
          "$value": "#f1f5f9"
        },
        "300": {
          "$value": "#cbd5e1"
        },
        "500": {
          "$value": "#64748b"
        },
        "600": {
          "$value": "#475569"
        },
        "700": {
          "$value": "#334155"
        },
        "900": {
          "$value": "#0f172a"
        },
        "950": {
          "$value": "#020617"
        }
      },
      "brand": {
        "400": {
          "$value": "#60a5fa"
        },
        "600": {
          "$value": "#2563eb"
        },
        "700": {
          "$value": "#1d4ed8"
        }
      },
      "red": {
        "600": {
          "$value": "#dc2626"
        },
        "400": {
          "$value": "#f87171"
        }
      },
      "green": {
        "700": {
          "$value": "#15803d"
        },
        "400": {
          "$value": "#4ade80"
        }
      },
      "amber": {
        "700": {
          "$value": "#b45309"
        },
        "300": {
          "$value": "#fcd34d"
        }
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "1": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "2": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "3": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "4": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "6": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "8": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "12": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "16": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      }
    },
    "font-size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 25,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 31,
          "unit": "px"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "full": {
        "$value": {
          "value": 9999,
          "unit": "px"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 250,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 400,
          "unit": "ms"
        }
      }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "$type": "color",
        "bg": {
          "$value": "{primitive.color.neutral.0}"
        },
        "surface": {
          "$value": "{primitive.color.neutral.50}"
        },
        "text": {
          "$value": "{primitive.color.neutral.900}"
        },
        "text-muted": {
          "$value": "{primitive.color.neutral.600}"
        },
        "border": {
          "$value": "{primitive.color.neutral.500}",
          "$description": "Bordes de inputs: >=3:1 sobre bg"
        },
        "action": {
          "$value": "{primitive.color.brand.600}"
        },
        "on-action": {
          "$value": "{primitive.color.neutral.0}"
        },
        "danger": {
          "$value": "{primitive.color.red.600}"
        },
        "success": {
          "$value": "{primitive.color.green.700}"
        },
        "warning": {
          "$value": "{primitive.color.amber.700}"
        },
        "focus": {
          "$value": "{primitive.color.brand.700}"
        }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "bg": {
          "$value": "{primitive.color.neutral.950}"
        },
        "surface": {
          "$value": "{primitive.color.neutral.900}"
        },
        "text": {
          "$value": "{primitive.color.neutral.50}"
        },
        "text-muted": {
          "$value": "{primitive.color.neutral.300}"
        },
        "border": {
          "$value": "{primitive.color.neutral.500}"
        },
        "action": {
          "$value": "{primitive.color.brand.400}"
        },
        "on-action": {
          "$value": "{primitive.color.neutral.950}"
        },
        "danger": {
          "$value": "{primitive.color.red.400}"
        },
        "success": {
          "$value": "{primitive.color.green.400}"
        },
        "warning": {
          "$value": "{primitive.color.amber.300}"
        },
        "focus": {
          "$value": "{primitive.color.brand.400}"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "target-min": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "WCAG 2.5.8 AA"
      },
      "target-touch": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "Material 48dp / iOS 44pt"
      }
    }
  },
  "$extensions": {
    "ux-kit.contrast-pairs": [
      {
        "fg": "semantic.light.color.text",
        "bg": "semantic.light.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.text-muted",
        "bg": "semantic.light.color.surface",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.on-action",
        "bg": "semantic.light.color.action",
        "min": 4.5
      },
      {
        "fg": "semantic.light.color.border",
        "bg": "semantic.light.color.bg",
        "min": 3.0
      },
      {
        "fg": "semantic.light.color.danger",
        "bg": "semantic.light.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.dark.color.text",
        "bg": "semantic.dark.color.bg",
        "min": 4.5
      },
      {
        "fg": "semantic.dark.color.text-muted",
        "bg": "semantic.dark.color.surface",
        "min": 4.5
      },
      {
        "fg": "semantic.dark.color.on-action",
        "bg": "semantic.dark.color.action",
        "min": 4.5
      },
      {
        "fg": "semantic.dark.color.border",
        "bg": "semantic.dark.color.bg",
        "min": 3.0
      },
      {
        "fg": "semantic.dark.color.danger",
        "bg": "semantic.dark.color.bg",
        "min": 4.5
      }
    ],
    "ux-kit.status": "placeholder"
  }
}