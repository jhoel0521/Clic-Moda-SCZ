// ==========================================
// IDENTIDAD (implementado en services/api; migraciones en
// src/shared/infrastructure/database/migrations)
// El resto del archivo describe el prototipo universitario y se
// reemplaza por rebanadas a medida que se construyen.
// ==========================================

Table users {
  id uuid [pk]
  email citext [unique, not null, note: 'sin distinguir mayúsculas']
  name varchar(100) [not null]
  email_verified boolean [not null, default: false]
  password_hash text [note: 'scrypt; null si la cuenta solo usa un proveedor externo']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_roles {
  user_id uuid [not null]
  role varchar(20) [not null, note: 'GERENTE | DESPACHO | ATENCION']
  Indexes {
    (user_id, role) [pk]
  }
}

Table user_role_events {
  id uuid [pk]
  user_id uuid [not null]
  previous_roles text[] [not null]
  new_roles text[] [not null]
  operator text [not null, note: 'quién hizo el cambio']
  occurred_at timestamptz [not null]
  Indexes {
    user_id
  }
  Note: 'Auditoría de cambios de rol; se escribe en la misma transacción que el cambio'
}

Table refresh_tokens {
  id text [pk]
  family_id text [not null]
  user_id text [not null]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  family_expires_at timestamptz [not null]
  used_at timestamptz
  claims jsonb
  Indexes {
    family_id
    user_id
  }
}

Table revoked_refresh_families {
  family_id text [pk]
  revoked_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
}

// ==========================================
// CATÁLOGO Y ALMACÉN (implementado: migraciones 1794400000001-4)
// Reemplaza a las tablas PRODUCTO, CATEGORIA y relacionadas del prototipo.
// ==========================================

Table categories {
  id uuid [pk]
  name citext [unique, not null, note: '2 a 60 caracteres, sin distinguir mayúsculas']
  slug text [unique, not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table products {
  id uuid [pk]
  category_id uuid [not null, note: 'ON DELETE RESTRICT: una categoría con productos no se borra']
  name varchar(120) [not null]
  description varchar(2000)
  active boolean [not null, default: true, note: 'los productos se desactivan, no se borran']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Indexes {
    category_id
  }
}

Table product_variants {
  id uuid [pk]
  product_id uuid [not null]
  sku citext [unique, not null]
  size varchar(20) [not null]
  color varchar(30)
  price_cents integer [not null, note: 'centavos de Bs; CHECK > 0 y <= 10000000']
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Único (product_id, size, coalesce(color, ""))'
}

Table stock_levels {
  variant_id uuid [pk]
  on_hand integer [not null, default: 0, note: 'CHECK >= 0']
  reserved integer [not null, default: 0, note: 'CHECK >= 0 y <= on_hand; la usan los pedidos (rebanadas 4 y 5)']
  location varchar(40)
  reorder_level integer [not null, default: 0]
  updated_at timestamptz [not null]
  Note: 'Disponible = on_hand - reserved. Sin fila = stock cero.'
}

Table stock_commands {
  id uuid [pk]
  seq bigint [unique, not null, note: 'orden de llegada (identidad de PostgreSQL)']
  variant_id uuid [not null]
  type varchar(10) [not null, note: 'RECEIVE | WITHDRAW | ADJUST']
  quantity integer [not null]
  reason varchar(200) [not null]
  operator text [not null]
  idempotency_key varchar(64) [unique]
  request_hash char(64) [not null]
  status varchar(10) [not null, default: 'PENDING', note: 'PENDING -> APPLIED | REJECTED']
  reject_reason varchar(40)
  attempts smallint [not null, default: 0]
  available_at timestamptz [not null]
  accepted_at timestamptz [not null]
  resolved_at timestamptz [note: 'nulo si y solo si está PENDING']
  movement_id uuid
  Note: 'Cola de comandos de stock; se resuelve en una transacción por comando'
}

Table stock_movements {
  id uuid [pk]
  variant_id uuid [not null]
  command_id uuid [unique, not null]
  type varchar(10) [not null]
  delta integer [not null, note: 'distinto de cero']
  reason varchar(200) [not null]
  operator text [not null]
  occurred_at timestamptz [not null]
  Note: 'Inmutable: un disparador impide UPDATE y DELETE'
}

Ref: categories.id < products.category_id
Ref: products.id < product_variants.product_id [delete: cascade]
Ref: product_variants.id - stock_levels.variant_id
Ref: product_variants.id < stock_commands.variant_id
Ref: product_variants.id < stock_movements.variant_id
Ref: stock_commands.id - stock_movements.command_id

// ==========================================
// CATÁLOGO DEL PROTOTIPO (obsoleto, solo referencia)
// ==========================================

Table PRODUCTO {
  id int [pk, increment]
  nombre varchar
  precio decimal
  stock json [note: 'Stock por talla: { "S": 5, "M": 3, "L": 2, "XL": 1 }']
  estado varchar
  tipo_tela varchar
  tallas json [note: 'Array de tallas disponibles: ["S", "M", "L", "XL"]']
  medidas_dinamicas json [note: 'Medidas por talla: { "S": "...", "M": "..." }']
  etiqueta_ids json [note: 'Array de IDs de etiquetas (relación M:N embebida)']
  tag_names json [note: 'Nombres de etiquetas denormalizados para búsqueda']
  creado_en datetime
}

Table CATEGORIA {
  id int [pk, increment]
  nombre varchar
}

Table PRODUCTO_CATEGORIA {
  producto_id int
  categoria_id int
  Indexes {
    (producto_id, categoria_id) [pk]
  }
}

Table ETIQUETA {
  id int [pk, increment]
  nombre varchar
  slug varchar [unique]
  note: 'Entidad independiente con CRUD propio. La relación M:N con PRODUCTO se maneja mediante el campo etiqueta_ids en PRODUCTO (embebido), no con tabla pivote.'
}

Table IMAGEN_PRODUCTO {
  id int [pk, increment]
  producto_id int
  url_imagen varchar
  es_principal boolean
}

// ==========================================
// EXPERIENCIA DEL CLIENTE
// ==========================================

Table FAVORITO {
  usuario_id int
  producto_id int
  agregado_en datetime
  Indexes {
    (usuario_id, producto_id) [pk]
  }
}

Table RESENA {
  id int [pk, increment]
  producto_id int
  usuario_id int
  calificacion_estrellas int
  comentario text
  estado_moderacion varchar
}

Table IMAGEN_RESENA {
  id int [pk, increment]
  resena_id int
  url_imagen varchar
}

// ==========================================
// COMPRAS Y TICKETS (LOGICA DE CUPONES AQUÍ)
// ==========================================

Table PEDIDO {
  id int [pk, increment]
  usuario_id int
  cupon_id int [null, note: 'Relación directa con el cupón usado']
  codigo_ticket varchar [unique]
  total_pagado decimal
  estado_entrega varchar
  fecha_compra datetime
}

Table ITEM_PEDIDO {
  id int [pk, increment]
  pedido_id int
  producto_id int
  cantidad int
  talla_seleccionada varchar
  precio_historico decimal
}

// ==========================================
// MARKETING Y PROMOCIONES
// ==========================================

Table CUPON_DESCUENTO {
  id int [pk, increment]
  codigo varchar [unique]
  porcentaje_descuento int
  fecha_caducidad datetime
  limite_usos int
  veces_usado int [default: 0]
}

Table BANNER_PROMOCIONAL {
  id int [pk, increment]
  titulo varchar
  url_pc varchar
  url_tablet varchar
  url_movil varchar
  activo boolean
}

Table NOTIFICACION_EMAIL {
  id int [pk, increment]
  pedido_id int
  estado_enviado varchar   // PENDIENTE | ENVIADO | ERROR
  enviado_en datetime
}

// ==========================================
// RELACIONES (FOREIGN KEYS)
// ==========================================

Ref: users.id < user_roles.user_id [delete: cascade]
Ref: users.id < user_role_events.user_id

Ref: users.id < FAVORITO.usuario_id
Ref: PRODUCTO.id < FAVORITO.producto_id

Ref: PRODUCTO.id < PRODUCTO_CATEGORIA.producto_id
Ref: CATEGORIA.id < PRODUCTO_CATEGORIA.categoria_id

Ref: PRODUCTO.id < IMAGEN_PRODUCTO.producto_id

Ref: users.id < PEDIDO.usuario_id
Ref: CUPON_DESCUENTO.id < PEDIDO.cupon_id
Ref: PEDIDO.id < ITEM_PEDIDO.pedido_id
Ref: NOTIFICACION_EMAIL.pedido_id < PEDIDO.id
Ref: PRODUCTO.id < ITEM_PEDIDO.producto_id

Ref: users.id < RESENA.usuario_id
Ref: PRODUCTO.id < RESENA.producto_id
Ref: RESENA.id < IMAGEN_RESENA.resena_id
